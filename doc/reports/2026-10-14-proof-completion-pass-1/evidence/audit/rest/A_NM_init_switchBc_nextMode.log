  forall P : nat -> Prop,
  (forall n : nat, {P n} + {~ P n}) ->
  {n : nat | ~ P n} + {forall n : nat, P n}
proof_irrelevance : forall (P : Prop) (p1 p2 : P), p1 = p2
period : Mode -> Time
nextMode_ent_mState :
  forall (p : ProcTerm) (l : Position) (h : Interface) 
