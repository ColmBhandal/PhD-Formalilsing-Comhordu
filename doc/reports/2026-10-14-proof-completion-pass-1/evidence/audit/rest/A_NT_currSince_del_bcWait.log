Axioms:
waitSurplus : Delay
transMax : Time
trans : Mode -> Time
speedMax : nonnegreal
ClassicalDedekindReals.sig_not_dec : forall P : Prop, {~ ~ P} + {~ P}
ClassicalDedekindReals.sig_forall_dec :
  forall P : nat -> Prop,
  (forall n : nat, {P n} + {~ P n}) ->
  {n : nat | ~ P n} + {forall n : nat, P n}
reachable_net_ent :
  forall (n : Network) (e : Entity) (i : nat),
  reachableNet n -> e @ i .: n -> reachableEnt e
reachable_ent_prot :
  forall (p : ProcTerm) (l : Position) (h : Interface) (k : ModeState),
  reachableEnt ([|p, l, h, k|]) -> reachableProt p
ProtAuxResults.reachableProt_triple :
  forall p : ProcTerm, reachableProt p -> protocolState p
reachableEnt : Entity -> Prop
proof_irrelevance : forall (P : Prop) (p1 p2 : P), p1 = p2
period : Mode -> Time
msgLatency : Time
modeTransTime : forall m1 m2 : Mode, m1 -mtr-> m2 -> Time
modeTransRelDec : forall m1 m2 : Mode, {m1 -mtr-> m2} + {~ m1 -mtr-> m2}
