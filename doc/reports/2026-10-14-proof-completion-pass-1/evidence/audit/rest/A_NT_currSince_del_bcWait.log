failSafe : Mode -> Prop
eqDecMode : eqDec Mode
currSince_bc_state :
  forall (n : Network) (m : Mode) (t : Time) (i : nat) (p : reachableNet n),
  currSince m t i n p ->
  (exists x, bcWaitStateNet m x i n) \/ (exists l, bcReadyStateNet m l i n)
currModeNet : Mode -> nat -> Network -> Prop
bcWaitNet_del_bkwd :
  forall (n n' : Network) (m : Mode) (x : Time) (i : nat) (d : Delay),
  n -ND- d -ND> n' ->
  bcWaitStateNet m x i n' -> bcWaitStateNet m (x +dt+ d) i n
